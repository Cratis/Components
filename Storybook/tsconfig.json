{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "allowJs": false,
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "rootDir": "..",
        "paths": {
            "virtual:cratis-renderer-preview": ["./preview/virtual-renderer-preview.tsx"]
        },
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node", "vitest/globals"]
    },
    "include": [
        "manager/**/*.ts",
        "manager/**/*.tsx",
        "preview/**/*.ts",
        "preview/**/*.tsx",
        "for_*/**/*.ts",
        "scripts/lib/*.d.mts",
        "vitest.config.ts",
        "vitest.storybook.config.ts",
        "vitest.viewport.config.ts",
        "vitest.designsystemet.config.ts",
        "vitest.scrollbars.config.ts",
        "../Adapters/*/.storybook/**/*.tsx",
        "../Adapters/Designsystemet/browser/surfaces*.tsx",
        "../Source/global.d.ts",
        "../Source/renderer/index.ts"
    ],
    "exclude": ["../Source/storybook-static", "node_modules"]
}
