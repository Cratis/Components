{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "baseUrl": ".",
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["./**/*.ts", "./**/*.tsx"],
    "exclude": ["dist", "**/for_*/**", "node_modules", "../node_modules"]
}
