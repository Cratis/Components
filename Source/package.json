{
    "name": "@cratis/components",
    "version": "3.0.0",
    "description": "",
    "author": "Cratis",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Cratis/Components"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "files": [
        "dist",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "MIGRATION.md",
        "!dist/**/*.stories.*",
        "!dist/**/given.*",
        "!dist/**/storybook-static/**",
        "!dist/**/vite.config.*",
        "!dist/**/vitest.storybook.config.*",
        "!dist/**/vitest.setup.*",
        "!dist/**/*.tsbuildinfo",
        "!dist/cjs/**"
    ],
    "main": "dist/esm/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/esm/index.d.ts",
            "import": "./dist/esm/index.js"
        },
        "./Canvas": {
            "types": "./dist/esm/Canvas/index.d.ts",
            "import": "./dist/esm/Canvas/index.js"
        },
        "./Chat": {
            "types": "./dist/esm/Chat/index.d.ts",
            "import": "./dist/esm/Chat/index.js"
        },
        "./CommandDialog": {
            "types": "./dist/esm/CommandDialog/index.d.ts",
            "import": "./dist/esm/CommandDialog/index.js"
        },
        "./CommandStepper": {
            "types": "./dist/esm/CommandDialog/CommandStepper.d.ts",
            "import": "./dist/esm/CommandDialog/CommandStepper.js"
        },
        "./CommandForm": {
            "types": "./dist/esm/CommandForm/index.d.ts",
            "import": "./dist/esm/CommandForm/index.js"
        },
        "./CommandForm/fields": {
            "types": "./dist/esm/CommandForm/index.d.ts",
            "import": "./dist/esm/CommandForm/index.js"
        },
        "./Common": {
            "types": "./dist/esm/Common/index.d.ts",
            "import": "./dist/esm/Common/index.js"
        },
        "./DataPage": {
            "types": "./dist/esm/DataPage/index.d.ts",
            "import": "./dist/esm/DataPage/index.js"
        },
        "./DataTables": {
            "types": "./dist/esm/DataTables/index.d.ts",
            "import": "./dist/esm/DataTables/index.js"
        },
        "./Dialogs": {
            "types": "./dist/esm/Dialogs/index.d.ts",
            "import": "./dist/esm/Dialogs/index.js"
        },
        "./Display": {
            "types": "./dist/esm/Display/index.d.ts",
            "import": "./dist/esm/Display/index.js"
        },
        "./Dropdown": {
            "types": "./dist/esm/Dropdown/index.d.ts",
            "import": "./dist/esm/Dropdown/index.js"
        },
        "./Filter": {
            "types": "./dist/esm/Filter/index.d.ts",
            "import": "./dist/esm/Filter/index.js"
        },
        "./Notifications": {
            "types": "./dist/esm/Notifications/index.d.ts",
            "import": "./dist/esm/Notifications/index.js"
        },
        "./ObjectContentEditor": {
            "types": "./dist/esm/ObjectContentEditor/index.d.ts",
            "import": "./dist/esm/ObjectContentEditor/index.js"
        },
        "./ObjectNavigationalBar": {
            "types": "./dist/esm/ObjectNavigationalBar/index.d.ts",
            "import": "./dist/esm/ObjectNavigationalBar/index.js"
        },
        "./PivotViewer": {
            "types": "./dist/esm/PivotViewer/index.d.ts",
            "import": "./dist/esm/PivotViewer/index.js"
        },
        "./renderer": {
            "types": "./dist/esm/renderer/index.d.ts",
            "import": "./dist/esm/renderer/index.js"
        },
        "./schemas/ui-adapter.schema.json": "./dist/esm/schemas/ui-adapter.schema.json",
        "./SchemaEditor": {
            "types": "./dist/esm/SchemaEditor/index.d.ts",
            "import": "./dist/esm/SchemaEditor/index.js"
        },
        "./TimeMachine": {
            "types": "./dist/esm/TimeMachine/index.d.ts",
            "import": "./dist/esm/TimeMachine/index.js"
        },
        "./Toolbar": {
            "types": "./dist/esm/Toolbar/index.d.ts",
            "import": "./dist/esm/Toolbar/index.js"
        },
        "./types": {
            "types": "./dist/esm/types/index.d.ts",
            "import": "./dist/esm/types/index.js"
        },
        "./styles": "./dist/esm/styles.css",
        "./tokens": "./dist/esm/tokens.css",
        "./theme": "./dist/esm/theme.css"
    },
    "scripts": {
        "generate-parts": "node ./scripts/generate-parts.mjs",
        "verify-parts-manifest": "node ./scripts/verify-parts-manifest.mjs",
        "prepare": "yarn generate-parts && yarn clean && yarn g:build",
        "clean": "rm -rf dist && yarn g:clean",
        "build": "yarn generate-parts && tsc -p tsconfig.json",
        "compile": "yarn generate-parts && tsc -p tsconfig.json -noEmit && yarn g:lint",
        "copy-css": "./scripts/copy-css.sh",
        "verify-exports": "node ./scripts/verify-exports.mjs",
        "verify-package-archive": "node ./scripts/verify-package-archive.mjs",
        "verify-packed-production": "node ./scripts/verify-packed-production.mjs",
        "verify-api-docs": "node ./scripts/verify-api-docs.mjs",
        "verify-public-types": "node ./scripts/verify-public-types.mjs",
        "verify-package-graph": "node ./scripts/verify-package-graph.mjs",
        "verify-no-pixi-consumer": "node ./scripts/verify-no-pixi-consumer.mjs",
        "verify-spatial-consumer": "node ./scripts/verify-spatial-consumer.mjs",
        "verify-provider-context-identity": "node ./scripts/verify-provider-context-identity.mjs",
        "verify-renderer-contracts": "node ./scripts/verify-renderer-contracts.mjs",
        "typecheck-stories": "node ../node_modules/typescript/bin/tsc -p tsconfig.stories.json",
        "test-storybook": "yarn test-storybook:light && yarn test-storybook:dark",
        "test-storybook:light": "STORYBOOK_APPEARANCE=baseline-light yarn g:test --config vitest.storybook.config.ts",
        "test-storybook:dark": "STORYBOOK_APPEARANCE=baseline-dark yarn g:test --config vitest.storybook.config.ts",
        "verify-storybook-index": "node ./scripts/verify-storybook-index.mjs",
        "lint": "yarn g:lint",
        "lint:ci": "yarn g:lint:ci",
        "test": "yarn g:test",
        "ci": "yarn generate-parts && yarn verify-parts-manifest && yarn g:ci && yarn typecheck-stories && yarn g:build && yarn verify-renderer-contracts",
        "up": "yarn g:up",
        "dev": "npx storybook dev -p 6006",
        "build-storybook": "npx storybook build"
    },
    "dependencies": {
        "@internationalized/date": "3.12.3",
        "allotment": "1.20.5",
        "framer-motion": "13.1.1",
        "react-aria-components": "1.20.0",
        "react-icons": "5.7.0",
        "ts-deepmerge": "8.0.0"
    },
    "devDependencies": {
        "@cratis/arc.vite": "22.3.0",
        "pixi.js": "^8.20.0"
    },
    "peerDependencies": {
        "@cratis/arc": ">=20.3.1 <23",
        "@cratis/arc.react": ">=20.3.1 <23",
        "@cratis/fundamentals": "^7.10.3",
        "pixi.js": "^8.20.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "reflect-metadata": "0.2.2",
        "tsyringe": "4.10.0"
    },
    "peerDependenciesMeta": {
        "pixi.js": {
            "optional": true
        }
    }
}
