{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "composite": false,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "skipLibCheck": false,
        "types": ["node", "vitest/globals"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "for_*/**/*.ts",
        "for_*/**/*.tsx",
        "vitest.config.ts",
        "vitest.setup.ts"
    ],
    "exclude": ["dist", "node_modules"]
}
