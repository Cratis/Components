{
    "name": "@cratis/components.designsystemet",
    "version": "4.0.0",
    "description": "Digdir Designsystemet presentation adapter for Cratis Components renderer ABI v1.",
    "keywords": [
        "cratis",
        "components",
        "react",
        "typescript",
        "cqrs",
        "ui",
        "designsystemet",
        "digdir"
    ],
    "homepage": "https://www.cratis.io/components/",
    "author": "Cratis",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/Cratis/Components"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "files": [
        "dist",
        "README.md",
        "CONFORMANCE.md",
        "THIRD_PARTY_NOTICES.md",
        "LICENSE"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "cratisUiAbi": 1,
    "cratis": {
        "kind": "ui-adapter",
        "id": "cratis-designsystemet",
        "displayName": "Cratis Designsystemet renderer",
        "abi": "^1",
        "level": "primitive",
        "profile": "stable-presentation/v1",
        "category": "designsystemet",
        "entry": "./dist/index.js",
        "export": "designsystemetUiLibrary",
        "slots": [
            "common.button",
            "common.iconButton",
            "common.textInput",
            "common.textArea",
            "common.checkbox",
            "common.radio",
            "common.switch",
            "common.progress",
            "common.surface",
            "dialogs.dialog"
        ],
        "modes": {
            "common.button": "presentation",
            "common.iconButton": "presentation",
            "common.textInput": "presentation",
            "common.textArea": "presentation",
            "common.checkbox": "presentation",
            "common.radio": "presentation",
            "common.switch": "presentation",
            "common.progress": "presentation",
            "common.surface": "presentation",
            "dialogs.dialog": "atomic"
        },
        "capabilities": [
            "slot.render",
            "parts.passthrough",
            "ssr.staticRender"
        ],
        "ssr": "safe",
        "a11y": {
            "axeProfile": "wcag22aa",
            "evidence": "./CONFORMANCE.md"
        },
        "license": {
            "spdx": "MIT",
            "requiresKey": false
        },
        "upstream": {
            "@digdir/designsystemet-react": ">=1.24 <2",
            "@digdir/designsystemet-css": ">=1.24 <2",
            "react": "^19.0.0",
            "react-dom": "^19.0.0"
        }
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "node ../../scripts/run-typescript.mjs -p tsconfig.build.json",
        "typecheck-specs": "yarn workspace @cratis/components prepare && yarn workspace @cratis/components.conformance build && node ../../scripts/run-typescript.mjs -p tsconfig.json",
        "lint": "node ../../node_modules/eslint/bin/eslint.js . --quiet",
        "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
        "verify-package": "node ./scripts/verify-packed-package.mjs",
        "ci": "yarn clean && yarn lint && yarn build && yarn typecheck-specs && yarn test && yarn verify-package"
    },
    "peerDependencies": {
        "@cratis/components": ">=4 <5",
        "@digdir/designsystemet-css": ">=1.24 <2",
        "@digdir/designsystemet-react": ">=1.24 <2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@cratis/arc": "22.16.0",
        "@cratis/arc.react": "22.16.0",
        "@cratis/components": "workspace:^",
        "@cratis/components.conformance": "workspace:^",
        "@cratis/fundamentals": "7.25.1",
        "@digdir/designsystemet-css": "1.24.0",
        "@digdir/designsystemet-react": "1.24.0",
        "@types/react": "^19.3.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "reflect-metadata": "0.2.2",
        "tsyringe": "4.10.0"
    }
}
